{
  "name": "minipc-deal-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram bot that hunts used Mini PC deals on Facebook groups",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "fb-login": "tsx scripts/fb-login.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.66.0",
    "playwright": "^1.49.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/node-telegram-bot-api": "^0.64.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
